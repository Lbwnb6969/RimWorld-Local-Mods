<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>EES_MarksmanAura</defName>
    <label>사격 지휘</label>
    <description>사격 장교의 지휘 아래 사격 정확도가 향상되었다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>

      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>0.20</ShootingAccuracyPawn>
          <AimingDelayFactor>-0.20</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>EES_AssaultAura</defName>
    <label>돌격 지휘</label>
    <description>돌격대장의 지휘 아래 기동력이 향상되었다.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.8</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>EES_WarlordProtected</defName>
    <label>전쟁군주의 가호</label>
    <description>전쟁군주가 살아있는 한 받는 피해가 감소한다(×0.75).</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>EES_WarlordExposed</defName>
    <label>전쟁군주의 상실</label>
    <description>전쟁군주가 쓰러져 사기가 무너지고 받는 피해가 급증한다(×2.5).</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>2.5</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
