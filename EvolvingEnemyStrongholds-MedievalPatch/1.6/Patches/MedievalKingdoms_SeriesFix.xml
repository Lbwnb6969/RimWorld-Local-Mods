  <!-- Christian cultures and memes share a very small vanilla deity-name pool.
       Route both generation paths through a large terminal-only local pool. -->
  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Ideology">
    <xpath>Defs/CultureDef[deityNameMaker="NamerDeityChristian"]/deityNameMaker</xpath>
    <value>
      <deityNameMaker>Local_NamerDeityChristianMedieval</deityNameMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Ideology">
    <xpath>Defs/MemeDef[deityNameMakerOverride="NamerDeityChristian"]/deityNameMakerOverride</xpath>
