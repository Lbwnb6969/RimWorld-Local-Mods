  <!-- EN: Palace Student -->
  <BA_Turkic_Enderun_Student.titleShort>宫廷学生</BA_Turkic_Enderun_Student.titleShort>
  
  <!-- EN: [PAWN_nameDef] spent childhood studying in a medrese, learning theology, literature, and philosophy. [PAWN_pronoun] grew up disciplined, studious, and contemplative, preparing for a life of scholarship or religious service.\n\n<i><color=#66E0E4FF>Medieval Kingdoms: The Turks</color></i> -->
  <BA_Turkic_Medrese_Student.description>[PAWN_nameDef]的童年在伊斯兰宗教学校学习度过，钻研神学、文学与哲学。[PAWN_pronoun]在成长过程中养成了纪律严明、勤奋好学、善于沉思的品性，为学术研究或宗教服务的人生道路做好了准备。</BA_Turkic_Medrese_Student.description>
  <!-- EN: Medrese Student -->
  <BA_Turkic_Medrese_Student.title>宗教学校学生</BA_Turkic_Medrese_Student.title>
  <!-- EN: Scholar -->
  <BA_Turkic_Medrese_Student.titleShort>小学者</BA_Turkic_Medrese_Student.titleShort>
  
  <!-- EN: [PAWN_nameDef] was taught the basics of swordplay and spear handling by family members. Early mornings and rigorous drills taught [PAWN_pronoun] patience and precision.\n\n<i><color=#66E0E4FF>Medieval Kingdoms: The Turks</color></i> -->
  <BA_Turkic_Military_Child_2.description>[PAWN_nameDef]由家人教授剑术与矛术的基础。清晨的刻苦训练让[PAWN_pronoun]学会了耐心与精准。</BA_Turkic_Military_Child_2.description>
  <!-- EN: Weapon Apprentice -->
  <BA_Turkic_Military_Child_2.title>武器学徒</BA_Turkic_Military_Child_2.title>
