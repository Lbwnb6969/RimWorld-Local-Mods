    <li>lessonAttribution->[founder_nameFull]'s [book] on [concept]</li>
    <li>book->speech</li>
    <li>book->eloquent speech</li>
    <li>book->rant</li>
    <li>book->tirade</li>
    <li>book->diatribe</li>
    <li>concept->pillaging</li>
    <li>concept->stealing from the weak</li>
    <li>concept->raiding</li>
