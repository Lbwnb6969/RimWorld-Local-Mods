<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription(asker_factionLeader==True)->[asker_nameFull], [asker_faction_leaderTitle] of [asker_faction_name], has informed us about a siege camp belonging to [siteFaction_name], set up near your location. They seem to be gathering numbers and will imminently attack your colony at [map_definite].\nIf you choose to attack preemptively, you will only need to face:\n[ListOfEnemies]\n\nIf you wait, they are bound to increase their numbers and will eventually attack you with a much larger force:\n[ListOfPotentialEnemies]</li>
    <li>questDescription(askerIsNull==true)->You have found out that there is a siege camp belonging to [siteFaction_name], set up near your location. They seem to be gathering numbers and will imminently attack your colony at [map_definite].\nIf you choose to attack preemptively, you will only need to face:\n[ListOfEnemies]\n\nIf you wait, they are bound to increase their numbers and will eventually attack you with a much larger force:\n[ListOfPotentialEnemies]</li>
  -->
  <VFEM2_OpportunitySite_SiegeCamp.questDescriptionRules.rulesStrings>
    <li>questDescription(asker_factionLeader==True)->[asker_faction_name]的[asker_faction_leaderTitle]，[asker_nameFull]，告知了我们[siteFaction_name]在我们附近设立了一个攻城营地。他们看起来正准备集结进攻你的[map_definite]殖民地。\n如果你选择先发制人，你只需要面对：\n[ListOfEnemies]\n\n但如果你坐视他们集结，他们预计会组织更多人手来进攻你：\n[ListOfPotentialEnemies]</li>
    <li>questDescription(askerIsNull==true)->你发现了[siteFaction_name]在你的位置附近设立了一个攻城营地。他们看起来正准备集结进攻你的[map_definite]殖民地。\n如果你选择先发制人，你只需要面对：\n[ListOfEnemies]\n\n但如果你坐视他们集结，他们预计会组织更多人手来进攻你：\n[ListOfPotentialEnemies]</li>
  </VFEM2_OpportunitySite_SiegeCamp.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[siteFaction_name]'s siege camp</li>
  -->
  <VFEM2_OpportunitySite_SiegeCamp.questNameRules.rulesStrings>
    <li>questName->[siteFaction_name]的攻城营地</li>
  </VFEM2_OpportunitySite_SiegeCamp.questNameRules.rulesStrings>
  <!-- EN: Quest expired: [resolvedQuestName] -->
  <VFEM2_OpportunitySite_SiegeCamp.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>任务已失效：[resolvedQuestName]</VFEM2_OpportunitySite_SiegeCamp.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>
  <!-- EN: The siege camp was not defeated in time. The quest [resolvedQuestName] has expired, and the enemy forces are now raiding your colony. -->
  <VFEM2_OpportunitySite_SiegeCamp.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>攻城营地没有被即时拔除。任务“[resolvedQuestName]”已经失效，敌人开始朝着你的殖民地进发。</VFEM2_OpportunitySite_SiegeCamp.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>
  <!-- EN: Camp defeated -->
  <VFEM2_OpportunitySite_SiegeCamp.root.nodes.siteAllEnemiesDefeated-1.node.nodes.Letter.label.slateRef>营地被拔除</VFEM2_OpportunitySite_SiegeCamp.root.nodes.siteAllEnemiesDefeated-1.node.nodes.Letter.label.slateRef>
  <!-- EN: You have successfully defeated the siege camp and the enemy forces! -->
  <VFEM2_OpportunitySite_SiegeCamp.root.nodes.siteAllEnemiesDefeated-1.node.nodes.Letter.text.slateRef>你已成功拔除敌军的攻城营地！</VFEM2_OpportunitySite_SiegeCamp.root.nodes.siteAllEnemiesDefeated-1.node.nodes.Letter.text.slateRef>
  
</LanguageData>