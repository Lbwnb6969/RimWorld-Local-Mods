  <BEWH_Ability_SteelRain_2.verbProperties.label>钢铁之雨 II</BEWH_Ability_SteelRain_2.verbProperties.label>
  <!-- EN: Inspire -->
  <BEWH_ChaplainInspire.label>鼓舞</BEWH_ChaplainInspire.label>
  <!-- EN: The Chaplain rallies his allies with strong, heartfelt words, filling them with an unshakable faith in their common cause. -->
  <BEWH_ChaplainInspire.description>牧师用坚定而真挚的话语鼓舞盟友，让他们对共同大业充满坚定不移的热枕。</BEWH_ChaplainInspire.description>
  <!-- EN: Using ability: {0} -->
  <BEWH_ChaplainInspire.jobReportString>使用能力：{0}</BEWH_ChaplainInspire.jobReportString>
