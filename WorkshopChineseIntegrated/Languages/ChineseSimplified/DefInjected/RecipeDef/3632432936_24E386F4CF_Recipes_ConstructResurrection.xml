<LanguageData>
  
  <!-- EN: resurrect heavy construct -->
  <VR_ResurrectHeavyConstruct.label>复活重型构装体</VR_ResurrectHeavyConstruct.label>
  <!-- EN: Resurrect a friendly construct of the heavy weight class. So long as the construct's body is not completely destroyed, it can be resurrected. -->
  <VR_ResurrectHeavyConstruct.description>复活一名友方重型构装体。只要构装体的躯体未被完全摧毁，就能复活。</VR_ResurrectHeavyConstruct.description>
  <!-- EN: Resurrecting mech. -->
  <VR_ResurrectHeavyConstruct.jobString>正在复活构装体。</VR_ResurrectHeavyConstruct.jobString>
  
