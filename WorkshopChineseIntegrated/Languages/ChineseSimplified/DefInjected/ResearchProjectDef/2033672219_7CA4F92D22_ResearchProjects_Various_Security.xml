<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: concealed defenses -->
  <VFES_ConcealedDefenses.label>潜匿防御</VFES_ConcealedDefenses.label>
  <!-- EN: Construct submersible barriers and turrets, perfect for indoor defenses. -->
  <VFES_ConcealedDefenses.description>解锁建造「潜匿路障」以及配套的「潜匿机枪塔」，构筑室内防御体系的完美选择。</VFES_ConcealedDefenses.description>
  <!-- EN:
    <li>subject->hidden strength</li>
    <li>subject_story->mastered the art of concealment, making fortifications vanish before the enemy's eyes</li>
    <li>subject_story->innovated with submersible turrets and traps, revealing strength at the moment of surprise</li>
    <li>subject_story->designed defenses that blend seamlessly with the environment, striking unseen</li>
    <li>subject_story->created a network of hidden armaments, ensuring security through invisibility</li>
    <li>subject_gerund->camouflaging power in plain sight</li>
  -->
  <VFES_ConcealedDefenses.generalRules.rulesStrings>
    <li>subject->隐蔽力量</li>
    <li>subject_story->掌握了潜匿的技艺，让防御工事于敌人眼中消失</li>
    <li>subject_story->革新了潜匿机枪塔与陷阱，予以敌人“惊喜”打击</li>
    <li>subject_story->设计了无缝隐蔽于环境的防御设施，在无形中发起攻击</li>
    <li>subject_story->打造了隐蔽军备网络，通过隐形来确保安全</li>
    <li>subject_gerund->让炮塔消失在众人眼前</li>
  </VFES_ConcealedDefenses.generalRules.rulesStrings>
  
  <!-- EN: electromagnetic pulse -->
  <VFES_EMPCannon.label>磁暴电弧炮塔</VFES_EMPCannon.label>
  <!-- EN: Develop EMP traps and tesla blasters capable of stunning mechanoids. -->
  <VFES_EMPCannon.description>解锁建造先进的「磁暴电弧炮塔」，防御机械族袭击的利器。</VFES_EMPCannon.description>
  <!-- EN:
    <li>subject->the silent storm</li>
    <li>subject_story->crafted weapons that speak in the language of lightning, silencing the mechanical behemoths of war</li>
    <li>subject_story->melded the might of electromagnetic pulses with strategic defense</li>
    <li>subject_story->paved the way for victory in silence, stunning adversaries with invisible force</li>
    <li>subject_story->mastered the dance of electrons to protect and paralyze</li>
    <li>subject_gerund->commanding the battlefield with the whisper of currents</li>
  -->
  <VFES_EMPCannon.generalRules.rulesStrings>
    <li>subject->寂静风暴</li>
    <li>subject_story->创造了以惊雷为言的武器，让战争巨兽沉寂不语</li>
    <li>subject_story->将EMP之力与战略防御相融合</li>
    <li>subject_story->以隐形之力眩晕敌人，在寂静中铺设了通往胜利的道路</li>
    <li>subject_story->掌握了用于保护和瘫痪的跃动电子</li>
    <li>subject_gerund->用纤细的电流指挥战地</li>
  </VFES_EMPCannon.generalRules.rulesStrings>
  
  <!-- EN: railgun -->
  <VFES_Railgun.label>电荷轨道炮塔</VFES_Railgun.label>
  <!-- EN: Adapt spacecraft weaponry as part of your defensive systems. -->
  <VFES_Railgun.description>解锁建造舰载武器级别的防御系统「电荷轨道炮塔」。</VFES_Railgun.description>
  <!-- EN:
    <li>subject->precision unleashed</li>
    <li>subject_story->adapted the devastating power of spacecraft armaments for ground warfare</li>
    <li>subject_story->engineered railguns to deliver unmatched velocity and destruction</li>
    <li>subject_story->redefined the art of siege with technology torn from the stars</li>
    <li>subject_story->ushered in a new age where the clash of titans is decided by the silent whisper of magnetic acceleration</li>
    <li>subject_gerund->bridging worlds with the thunder of railguns</li>
  -->
  <VFES_Railgun.generalRules.rulesStrings>
    <li>subject->精准释放</li>
    <li>subject_story->将飞船武备用在了地面战斗上</li>
    <li>subject_story->设计了具有极高弹速与破坏力的轨道炮</li>
    <li>subject_story->利用从群星间撕取的技术重新定义了攻城的技艺</li>
    <li>subject_story->引领了一个以电磁加速的寂静私语决定各方势力冲突的新时代</li>
    <li>subject_gerund->用轨道炮发出的轰鸣声桥接世界</li>
  </VFES_Railgun.generalRules.rulesStrings>
  
  <!-- EN: repulsor technology -->
  <VFES_RepulsorTechnology.label>斥力护盾技术</VFES_RepulsorTechnology.label>
  <!-- EN: Build ultratech shield generators that project energy fields to repel projectiles. -->
  <VFES_RepulsorTechnology.description>解锁建造极致科技的「斥力护盾发生器」，能产生动能排斥场，保护内部的一切不受伤害。</VFES_RepulsorTechnology.description>
  <!-- EN:
    <li>subject->force fields forged</li>
    <li>subject_story->unveiled the secrets of repulsor tech, casting domes of protection across the land</li>
    <li>subject_story->engineered bastions of safety, where energy shields deflect the fury of war</li>
    <li>subject_story->merged the ancient dreams of invincibility with the tangible touch of science</li>
    <li>subject_story->ensured peace within the storm, under the watchful gaze of shimmering barriers</li>
    <li>subject_gerund->weaving the fabric of defense with threads of pure energy</li>
  -->
  <VFES_RepulsorTechnology.generalRules.rulesStrings>
    <li>subject->力场作成</li>
    <li>subject_story->揭示了护盾技术的秘密，打造笼罩大片区域的防护穹顶</li>
    <li>subject_story->设计了利用能量护盾偏转战争怒火的安全壁垒</li>
    <li>subject_story->融合了无敌的远古之梦和科学的真实之触</li>
    <li>subject_story->在闪耀屏障的警惕凝视下，确保了风暴之中的和平</li>
    <li>subject_gerund->用纯净的能量丝线纺制防御织物</li>
  </VFES_RepulsorTechnology.generalRules.rulesStrings>
  
  <!-- EN: siege equipment -->
  <VFES_SiegeEquipment.label>攻城器械</VFES_SiegeEquipment.label>
  <!-- EN: Construct medieval siege equipment. -->
  <VFES_SiegeEquipment.description>解锁建造中世纪的攻城器械。</VFES_SiegeEquipment.description>
  <!-- EN:
    <li>subject->masters of siege</li>
    <li>subject_story->revived ancient methods for breaching the stoutest defenses</li>
    <li>subject_story->crafted engines of war that thunder across fields, striking fear into foes</li>
    <li>subject_story->engineered trebuchets and battering rams from sturdy timber and iron</li>
    <li>subject_story->led sieges that would become legendary, their tactics studied for ages</li>
    <li>subject_gerund->laying siege to the future by rediscovering the past</li>
  -->
  <VFES_SiegeEquipment.generalRules.rulesStrings>
    <li>subject->攻城大师</li>
    <li>subject_story->重现了破开固若金汤防御的远古方法</li>
    <li>subject_story->建造了轰鸣声响彻战场的战争引擎，令敌人闻风丧胆</li>
    <li>subject_story->设计了由坚固的木材与铁组成的投石机与攻城锤</li>
    <li>subject_story->发起了将成为传说的攻城，他们的战术被后世研究了很长时间</li>
    <li>subject_gerund->通过再现过去以向未来发起攻城</li>
  </VFES_SiegeEquipment.generalRules.rulesStrings>
  
  <!-- EN: trench warfare -->
  <VWE_TrenchWarfare.label>阵地战</VWE_TrenchWarfare.label>
  <!-- EN: Adapt a trench warfare doctrine with a selection of weapons for close-quarters combat. -->
  <VWE_TrenchWarfare.description>深入研习阵地战理论，解锁建造近距离防御武器以及各种各样的阵地结构。</VWE_TrenchWarfare.description>
  <!-- EN:
    <li>subject->digging in</li>
    <li>subject_story->adopted the grim tactics of entrenched battles, shaping landscapes into mazes of mud and death</li>
    <li>subject_story->innovated with rapid entrenching tools and techniques for swift fortification</li>
    <li>subject_story->balanced the horror of no-man's-land with the safety of well-prepared defenses</li>
    <li>subject_story->transformed warfare with the introduction of close-quarters combat within the earth's embrace</li>
    <li>subject_gerund->embracing the earth for protection and strategy</li>
  -->
  <VWE_TrenchWarfare.generalRules.rulesStrings>
    <li>subject->挖掘战壕</li>
    <li>subject_story->采用了固守作战的坚定战术，将附近的地形塑造成了泥土与死亡的迷宫</li>
    <li>subject_story->革新了掘壕工具和技术以实现快速搭建防御工事</li>
    <li>subject_story->平衡了无人区的恐怖和严防区的安全</li>
    <li>subject_story->在大地的拥抱中引入近距离作战，改变了战争</li>
    <li>subject_gerund->为防护和战略而拥抱大地</li>
  </VWE_TrenchWarfare.generalRules.rulesStrings>
  
</LanguageData>