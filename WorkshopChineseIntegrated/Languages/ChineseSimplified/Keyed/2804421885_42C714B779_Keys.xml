<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

  <!-- EN: Map Preview -->
  <MapPreview.Title>Map Preview</MapPreview.Title>

  <!-- EN: Preview -->
  <MapPreview.Settings.Tab.Preview>地形预览图</MapPreview.Settings.Tab.Preview>
  <!-- EN: Toolbar -->
  <MapPreview.Settings.Tab.Toolbar>工具栏</MapPreview.Settings.Tab.Toolbar>
  <!-- EN: Show map previews ... -->
  <MapPreview.Settings.EnableMapPreviewHeader>显示地形预览图...</MapPreview.Settings.EnableMapPreviewHeader>
  <!-- EN: ... while starting a new game (choosing the tile to settle on) -->
  <MapPreview.Settings.EnableMapPreviewInEntry>↘当生成新的世界时（着陆点选择界面）</MapPreview.Settings.EnableMapPreviewInEntry>
  <!-- EN: ... while playing (on the world map screen) -->
  <MapPreview.Settings.EnableMapPreviewInPlay>↘当游玩已有存档时（世界地图界面）</MapPreview.Settings.EnableMapPreviewInPlay>
  <!-- EN: Show world map toolbar ... -->
  <MapPreview.Settings.EnableToolbarHeader>显示世界地图工具栏...</MapPreview.Settings.EnableToolbarHeader>
  <!-- EN: ... while starting a new game (choosing the tile to settle on) -->
  <MapPreview.Settings.EnableToolbarInEntry>↘当生成新的世界时（着陆点选择界面）</MapPreview.Settings.EnableToolbarInEntry>
  <!-- EN: ... while playing (on the world map screen) -->
  <MapPreview.Settings.EnableToolbarInPlay>↘当游玩已有存档时（世界地图界面）</MapPreview.Settings.EnableToolbarInPlay>
  <!-- EN: Lock window positions -->
  <MapPreview.Settings.LockWindowPositions>锁定地形预览图視窗的位置</MapPreview.Settings.LockWindowPositions>
  <!-- EN: Enable animation on preview completion -->
  <MapPreview.Settings.EnablePreviewAnimations>启用地形预览图加载完成时的弹出动画</MapPreview.Settings.EnablePreviewAnimations>
  <!-- EN: Automatically open preview window when switching to the world map -->
  <MapPreview.Settings.AutoOpenPreviewOnWorldMap>打开世界地图界面时自动显示地形预览图視窗</MapPreview.Settings.AutoOpenPreviewOnWorldMap>
  <!-- EN: Show map preview when a settlement or quest site is selected -->
  <MapPreview.Settings.TriggerPreviewOnWorldObjects>选中定居点或任务点时显示地形预览图視窗</MapPreview.Settings.TriggerPreviewOnWorldObjects>
  <!-- EN: Show map seed reroll button -->
  <MapPreview.Settings.EnableSeedRerollFeature>显示地图种子随机重置按钮</MapPreview.Settings.EnableSeedRerollFeature>
  <!-- EN: Show map seed reroll button (not available because Map Reroll mod is installed) -->
  <MapPreview.Settings.EnableSeedRerollFeature.MapRerollConflict>显示地图种子随机重置按钮（已加载Map Reroll，此功能自动禁用）</MapPreview.Settings.EnableSeedRerollFeature.MapRerollConflict>
  <!-- EN: Use reroll helper window (hold shift when clicking reroll button to invert) -->
  <MapPreview.Settings.EnableSeedRerollWindow>启用地图种子随机重置小帮手視窗（按住Shift键后再左键单击“地图种子随机重置”按钮，以切换显示模式）</MapPreview.Settings.EnableSeedRerollWindow>
  <!-- EN: Show world seed reroll button -->
  <MapPreview.Settings.EnableWorldSeedRerollFeature>显示世界种子随机重置按钮</MapPreview.Settings.EnableWorldSeedRerollFeature>
  <!-- EN: Preview window size -->
  <MapPreview.Settings.PreviewWindowSize>地形预览图視窗大小（視窗形状无法更改，固定为正方形）</MapPreview.Settings.PreviewWindowSize>
  <!-- EN: Include caves in preview (disable to make preview generation faster) -->
  <MapPreview.Settings.IncludeCaves>地形预览图中显示洞穴（禁用此项后，会提高地形预览图的生成速度）</MapPreview.Settings.IncludeCaves>
  <!-- EN: Use true terrain colors (enables support for terrain added by mods, also applies to Map Reroll) -->
  <MapPreview.Settings.EnableTrueTerrainColors>启用真实地形颜色（若禁用此项，其他Mod所添加的地形将只会以灰色显示。对Map Reroll的“重置地图”功能同样起效。）</MapPreview.Settings.EnableTrueTerrainColors>
  <!-- EN: Use river generator optimization (faster, but slightly different from vanilla) -->
  <MapPreview.Settings.SkipRiverFlowCalc>启用更好的河流生成器（生成速度更快，但又有别于原版的生成器）</MapPreview.Settings.SkipRiverFlowCalc>
  <!-- EN: Compatibility mode (increases memory usage, but can help if you have mod compatibility issues) -->
  <MapPreview.Settings.CompatibilityMode>启用兼容模式（以加大内存占用为代价，提高与其他Mod间的兼容性）</MapPreview.Settings.CompatibilityMode>
  <!-- EN: Refresh terrain colors -->
  <MapPreview.Settings.RefreshTerrainColors>刷新地形颜色</MapPreview.Settings.RefreshTerrainColors>
  <!-- EN: Change map size or starting season -->
  <MapPreview.Settings.OpenAdvancedGameConfig>调整地图大小或起始季节</MapPreview.Settings.OpenAdvancedGameConfig>

  <!-- EN: There is a map preview currently generating, please wait before continuing... -->
  <MapPreview.World.WaitForPreview>当前区格正在生成地形预览图，请稍安勿躁...</MapPreview.World.WaitForPreview>
  <!-- EN: Toggle map preview. -->
  <MapPreview.World.ShowHidePreview>开关地形预览图視窗。</MapPreview.World.ShowHidePreview>
  <!-- EN: Reroll the seed for this map. -->
  <MapPreview.World.RerollMapSeed>以随机种子重新生成当前地图。</MapPreview.World.RerollMapSeed>
  <!-- EN: Undo rerolls and reset the seed for this map to the original one. -->
  <MapPreview.World.ResetMapSeed>撤销所有重新生成操作，将当前地图的种子还原至初始状态。</MapPreview.World.ResetMapSeed>
  <!-- EN: Generate a new world with a random seed. -->
  <MapPreview.World.RerollWorldSeed>一键重新生成新的世界（派系、人口密度等设置保持不变，仅随机重置星球种子）。</MapPreview.World.RerollWorldSeed>
  <!-- EN: Open Map Preview settings. -->
  <MapPreview.World.OpenSettings>打开Map Preview的设置面板。</MapPreview.World.OpenSettings>

  <!-- EN: Reroll Map Seed -->
  <MapPreview.World.RerollWindow.Title>种子随机重置</MapPreview.World.RerollWindow.Title>
  <!-- EN: Close -->
  <MapPreview.World.RerollWindow.Close>关闭</MapPreview.World.RerollWindow.Close>
  <!-- EN: Refresh seeds (hold shift to jump) -->
  <MapPreview.World.RerollWindow.RefreshSeeds>刷新地图种子（每个种子左下角都有对应的序号，按住Shift键后再左键单击此按钮可以呼出搜索栏，输入数字即可查找指定序号的种子）</MapPreview.World.RerollWindow.RefreshSeeds>
  <!-- EN: Zoom out -->
  <MapPreview.World.RerollWindow.ZoomOut>缩小</MapPreview.World.RerollWindow.ZoomOut>
  <!-- EN: Zoom in -->
  <MapPreview.World.RerollWindow.ZoomIn>放大</MapPreview.World.RerollWindow.ZoomIn>
  <!-- EN: Apply this seed -->
  <MapPreview.World.RerollWindow.Apply>应用这个种子</MapPreview.World.RerollWindow.Apply>
  <!-- EN: Pin this seed -->
  <MapPreview.World.RerollWindow.Pin>固定这个种子</MapPreview.World.RerollWindow.Pin>
  <!-- EN: Unpin this seed -->
  <MapPreview.World.RerollWindow.Unpin>取消固定这个种子</MapPreview.World.RerollWindow.Unpin>
  <!-- EN: Enter number of rerolls: -->
  <MapPreview.World.RerollWindow.GoTo.Label>输入种子序号：</MapPreview.World.RerollWindow.GoTo.Label>
  <!-- EN: Invalid number, only digits and + are allowed. -->
  <MapPreview.World.RerollWindow.GoTo.Invalid>输入无效，仅支持阿拉伯数字。</MapPreview.World.RerollWindow.GoTo.Invalid>

  <!-- EN: A conflict with one of your mods has caused the map preview generator to fail. Please report this on the Map Preview workshop page so that a compatibility patch can be created. After closing this message, please upload your log file and include that link in your bug report. -->
  <MapPreview.PreviewGenerationFailed>由于与其他Mod间的冲突，地形预览图生成器加载失败了。为了便于作者解决这些兼容性问题，请在本Mod的工坊界面里进行反馈并附上游戏日志（Logs）文件的链接。</MapPreview.PreviewGenerationFailed>

  <!-- EN: Open Map Designer. -->
  <MapPreview.Integration.MapDesigner.OpenSettings>打开Map Designer的设置面板。</MapPreview.Integration.MapDesigner.OpenSettings>
  <!-- EN: Map Designer can not be used on this tile. -->
  <MapPreview.Integration.MapDesigner.UnavailableForTile>Map Designer无法应用于此区格。</MapPreview.Integration.MapDesigner.UnavailableForTile>
  <!-- EN: Show Map Designer button -->
  <MapPreview.Integration.MapDesigner.Enabled>显示Map Designer的设置按钮</MapPreview.Integration.MapDesigner.Enabled>

  <!-- EN: Open Prepare Landing. -->
  <MapPreview.Integration.PrepareLanding.Open>打开Prepare Landing的设置面板。</MapPreview.Integration.PrepareLanding.Open>
  <!-- EN: Show Prepare Landing button -->
  <MapPreview.Integration.PrepareLanding.Enabled>显示Prepare Landing的设置按钮</MapPreview.Integration.PrepareLanding.Enabled>

  <!-- EN: Open World Edit. -->
  <MapPreview.Integration.WorldEdit.Open>打开WorldEdit 2.0的设置面板。</MapPreview.Integration.WorldEdit.Open>
  <!-- EN: Show World Edit button -->
  <MapPreview.Integration.WorldEdit.Enabled>显示WorldEdit 2.0的设置按钮</MapPreview.Integration.WorldEdit.Enabled>

  <!-- EN: Open landform settings. -->
  <MapPreview.Integration.LandformSettings.Open>打开Geological Landforms的设置面板。</MapPreview.Integration.LandformSettings.Open>
  <!-- EN: Show landform settings button -->
  <MapPreview.Integration.LandformSettings.Enabled>显示Geological Landforms的设置按钮</MapPreview.Integration.LandformSettings.Enabled>


</LanguageData>