  <RG.BatheZone>洗浴区</RG.BatheZone>
	<!-- EN: Create a zone where your colonists are allowed to bathe in water. -->
  <RG.DesignatorBatheZoneDesc>创建一片可供殖民者洗浴的区域。</RG.DesignatorBatheZoneDesc>
