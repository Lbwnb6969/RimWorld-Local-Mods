    <techLevel>Archotech</techLevel>
    <relicChance>3</relicChance>
    <weaponClasses>
      <li>Melee</li>
      <li>Ultratech</li>
    </weaponClasses>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
