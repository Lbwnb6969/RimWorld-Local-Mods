<Defs>
  <!--Melee weapons-->
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>GW_SM_Melee_EmperorClaw</defName>
    <label>Emperor's Lightning Claw</label>
    <description>An auramite-plated Lightning Claw, designed after the one used by the Emperor of Mankind. A single stroke of this weapon could separate an armored warrior into so many pieces.\n\nMuch is said of the Emperor, but one must never say he did not sacrifice much to defeat Horus.</description>
    <graphicData>
      <texPath>Things/Weapons/EmperorClaw</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <equippedAngleOffset>-90</equippedAngleOffset>
    <weaponTags Inherit="False">
      <li>GW_EmperorWep</li>
    </weaponTags>
    <!-- These recipes should use autoforging and cant use the usual recipe maker -->
    <recipeMaker Inherit="false" IsNull="True" />
    <!-- <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef> -->
    <!-- <skillRequirements> -->
    <!-- <Crafting>20</Crafting> -->
    <!-- <Intellectual>15</Intellectual> -->
    <!-- </skillRequirements> -->
    <!-- <recipeUsers Inherit="false"> -->
    <!-- <li>GW_Autoforge</li> -->
    <!-- </recipeUsers> -->
    <!-- <researchPrerequisite>GW_Rulers_OneTrueArmor</researchPrerequisite> -->
    <!-- </recipeMaker> -->
    <costList>
      <ComponentSpacer>65</ComponentSpacer>
      <Plasteel>1600</Plasteel>
      <Gold>562</Gold>
      <Uranium>440</Uranium>
    </costList>
    <stuffCategories Inherit="False" IsNull="True" />
    <costStuffCount />
    <tradeability>Sellable</tradeability>
    <uiIconScale>1.2</uiIconScale>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToMake>240000</WorkToMake>
      <Mass>12</Mass>
      <MarketValue>4000</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.50</MoveSpeed>
      <PawnBeauty>10</PawnBeauty>
    </equippedStatOffsets>
    <techLevel>Archotech</techLevel>
    <relicChance>3</relicChance>
    <weaponClasses>
      <li>Melee</li>
      <li>Ultratech</li>
    </weaponClasses>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
        <chanceFactor>0.07</chanceFactor>
        <armorPenetration>0.17</armorPenetration>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.5</cooldownTime>
        <chanceFactor>0.5</chanceFactor>
        <armorPenetration>0.70</armorPenetration>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>42</power>
        <cooldownTime>2.8</cooldownTime>
        <chanceFactor>1</chanceFactor>
        <armorPenetration>0.65</armorPenetration>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Biocodable">
        <biocodeOnEquip>True</biocodeOnEquip>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>GW_SM_Melee_ValdorSpear</defName>
    <label>Apollonian Spear</label>
    <description>A masterfully-crafted Guardian Spear patterned after the right hand of Constantin Valdor himself. Not only does it cleave and blast through foes like so much butter, but it also grants truths to its wielder from those it cuts - as the enemy falls, the wielder reaps their skills.\n\nAfter the disappearance of Constantin Valdor, the true Apollonian Spear was placed in storage, worshipped by the Adeptus Custodes as a holy relic.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Weapons/GW_HRM_Valdor_Spear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <weaponTags Inherit="False">
