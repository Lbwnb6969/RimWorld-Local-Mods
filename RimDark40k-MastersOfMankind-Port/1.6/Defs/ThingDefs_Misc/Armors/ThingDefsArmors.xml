  <ThingDef ParentName="GW_Rulers_ArmorBase">
    <defName>GW_Rulers_ValdorArmorW</defName>
    <label>Corinthine Warplate (W)</label>
    <description>The Power Armor of Constantin Valdor, the first Captain-General of the Legio Custodes. This armor is the stuff of legend, turning the user into a stalwart, auramite juggernaut. \n\nValdor was the first Custodian successfully produced by the Emperor's gene-craft, and has always been held as the greatest of them all. At the dawn of the Horus Heresy, he had earned nearly two thousand names, and a full transcription of them was enough to fill an entire book.</description>
    <graphicData>
      <texPath>Valdor/GW_HRM_Valdor_ArmorW_south</texPath>
    </graphicData>
    <recipeMaker Inherit="false" IsNull="True" />
    <!-- <researchPrerequisite>GW_Rulers_FirstCaptainr</researchPrerequisite> -->
    <!-- </recipeMaker> -->
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.4</ShootingAccuracyPawn>
      <PainShockThreshold>0.2</PainShockThreshold>
      <InjuryHealingFactor>0.4</InjuryHealingFactor>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>240000</WorkToMake>
      <MaxHitPoints>1200</MaxHitPoints>
      <MarketValue>7800</MarketValue>
      <Mass>11</Mass>
      <Flammability>0.0</Flammability>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.75</ArmorRating_Blunt>
      <ArmorRating_Heat>1.6</ArmorRating_Heat>
      <Insulation_Cold>15</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <EnergyShieldRechargeRate>0.50</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>3</EnergyShieldEnergyMax>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Plasteel>360</Plasteel>
      <Gold>72</Gold>
      <Uranium>55</Uranium>
      <ComponentSpacer>15</ComponentSpacer>
      <ComponentIndustrial>18</ComponentIndustrial>
    </costList>
    <apparel>
      <wornGraphicPath>Valdor/GW_HRM_Valdor_ArmorW</wornGraphicPath>
      <tags>
        <li>GW_ChapterMaster</li>
      </tags>
      <drawData>
        <scale>1.4</scale>
      </drawData>
    </apparel>
    <comps>
      <li Class="RimDark.MastersOfMankind.CompProperties_ApparelSet">
        <apparelSetEffect>
          <allApparels>
            <li>GW_Rulers_ValdorArmorW</li>
            <li>GW_Rulers_ValdorShoulderW</li>
            <li>GW_Rulers_ValdorHelmetW</li>
          </allApparels>
          <hediff>GW_Ruler_ValdorShieldBonus</hediff>
        </apparelSetEffect>
      </li>
      <li Class="CompProperties_Shield">
        <startingTicksToReset>3200</startingTicksToReset>
        <minDrawSize>1.8</minDrawSize>
        <maxDrawSize>2</maxDrawSize>
        <energyLossPerDamage>0.033</energyLossPerDamage>
        <energyOnReset>0.2</energyOnReset>
        <blocksRangedWeapons>false</blocksRangedWeapons>
      </li>
    </comps>
  </ThingDef>
