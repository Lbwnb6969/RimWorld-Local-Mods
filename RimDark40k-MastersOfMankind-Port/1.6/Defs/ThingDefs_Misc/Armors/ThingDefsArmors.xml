  <ThingDef ParentName="GW_Rulers_ArmorBase">
    <defName>GW_Rulers_MalcadorOutfit</defName>
    <label>Robes of Malcador</label>
    <description>A master-crafted set of robes akin to those worn by Malcador the Sigillite, the closest advisor of the Emperor of Mankind. Auramite and ceramite reinforcement makes this a deceptively-protective piece of apparel, but one has to be a potent psyker to wear it. \n\nMalcador met the Emperor as He began His conquest, and was the one who recommended that He take on His title. The Sigillite served loyally as the Imperium ascended to the stars, with his mastery of organisation keeping the ever-expanding empire in order. \n\nHowever, he was also the first Grand Master of Assassins, ordering the elimination of the Imperium's enemies from the shadows.</description>
    <graphicData>
      <texPath>Malcador/Apparel/GW_HRM_MalcadorRobe_Male_south</texPath>
    </graphicData>
    <recipeMaker Inherit="false" IsNull="True" />
    <!-- <researchPrerequisite>GW_Rulers_EmperorRightHand</researchPrerequisite> -->
    <!-- </recipeMaker> -->
    <equippedStatOffsets>
      <TradePriceImprovement>0.3</TradePriceImprovement>
      <SocialImpact>0.3</SocialImpact>
      <MoveSpeed>1</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>240000</WorkToMake>
      <MaxHitPoints>1200</MaxHitPoints>
      <MarketValue>7800</MarketValue>
      <Mass>11</Mass>
      <Flammability>0.0</Flammability>
      <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <ArmorRating_Heat>1.4</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>50</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Hyperweave>150</Hyperweave>
      <Gold>60</Gold>
      <Uranium>40</Uranium>
      <Plasteel>90</Plasteel>
      <ComponentSpacer>14</ComponentSpacer>
    </costList>
    <apparel>
      <wornGraphicPath>Malcador/Apparel/GW_HRM_MalcadorRobe</wornGraphicPath>
      <tags>
        <li>GW_ChapterMaster</li>
      </tags>
    </apparel>
    <comps>
      <li Class="RimDark.MastersOfMankind.CompProperties_ApparelSet">
        <apparelSetEffect>
          <allApparels>
            <li>GW_Rulers_MalcadorOutfit</li>
            <li>GW_Rulers_MalcadorHelmet</li>
          </allApparels>
          <hediff>GW_Ruler_MalcadorBonus</hediff>
