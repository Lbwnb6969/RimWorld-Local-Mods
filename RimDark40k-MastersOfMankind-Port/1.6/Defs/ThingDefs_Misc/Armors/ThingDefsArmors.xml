<Defs>
  <ThingDef Abstract="true" Name="GW_Rulers_ArmorBase" ParentName="ArmorMachineableBase">
    <techLevel>Spacer</techLevel>
    <!-- These recipes should use autoforging and cant use the usual recipe maker -->
    <recipeMaker Inherit="false" IsNull="True" />
    <!-- <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef> -->
    <!-- <skillRequirements> -->
    <!-- <Crafting>20</Crafting> -->
    <!-- <Intellectual>15</Intellectual> -->
    <!-- </skillRequirements> -->
    <!-- <recipeUsers Inherit="false"> -->
    <!-- <li>GW_Autoforge</li> -->
    <!-- </recipeUsers> -->
    <!-- </recipeMaker> -->
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1</drawSize>
    </graphicData>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <uiIconScale>1</uiIconScale>
    <equippedStatOffsets>
      <PawnBeauty>50</PawnBeauty>
      <HypoxiaResistance MayRequire="kentington.saveourship2">0.75</HypoxiaResistance>
      <DecompressionResistance MayRequire="kentington.saveourship2">0.75</DecompressionResistance>
      <VacuumSpeedMultiplier MayRequire="kentington.saveourship2">4</VacuumSpeedMultiplier>
      <VacuumResistance MayRequire="ludeon.rimworld.odyssey">0.6</VacuumResistance>
    </equippedStatOffsets>
    <apparel>
      <drawData>
        <dataNorth>
          <layer>74</layer>
          <!-- <offset>(0.0, 0.0, 0.0)</offset> -->
        </dataNorth>
        <dataWest>
          <offset>(0.0, 0.0, -0.1)</offset>
        </dataWest>
        <dataEast>
          <offset>(0.0, 0.0, -0.1)</offset>
        </dataEast>
        <!--<scale>1.5</scale> Uncomment these to increase size while equipped
                <childScale>1.5</childScale>-->
      </drawData>
      <tags>
        <li>Spacer</li>
        <li>EVA</li>
        <li>PrestigeCombatGear</li>
        <li>RoyalTier7</li>
      </tags>
      <useWornGraphicMask>true</useWornGraphicMask>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li MayRequire="ceteam.combatextended">Hands</li>
        <li MayRequire="ceteam.combatextended">Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <comps>
      <li MayRequire="kentington.saveourship2">
        <compClass>SaveOurShip2.CompEVA</compClass>
      </li>
    </comps>
    <modExtensions>
      <li Class="VEF.Apparels.ApparelExtension">
        <isUnifiedApparel>true</isUnifiedApparel>
        <hideHead>false</hideHead>
      </li>
      <li Class="CombatExtended.PartialArmorExt" MayRequire="ceteam.combatextended">
        <stats>
          <li>
            <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
            <parts>
              <li>Hand</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Blunt>0.8</ArmorRating_Blunt>
            <parts>
              <li>Hand</li>
            </parts>
          </li>
        </stats>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="GW_Rulers_ArmorBase">
    <defName>GW_Rulers_EmperorArmorW</defName>
    <label>One True Armor (W)</label>
    <description>A truly majestic suit of auramite Power Armor, patterned after the legendary suit worn by the God-Emperor of Mankind. Its protection is unrivalled - but it can only be worn by those with a high degree of psychic potential. \n\nThe Emperor has guided mankind from time immemorial, adopting various guises throughout history. It was only during the Age of Strife that He emerged in His full majesty, founded the Imperium of Mankind, and sallied forth across the galaxy to build His empire.</description>
    <graphicData>
      <texPath>Emperor/GW_HRM_Emperor_ArmorW_south</texPath>
    </graphicData>
    <recipeMaker Inherit="false" IsNull="True" />
    <!-- <researchPrerequisite>GW_Rulers_OneTrueArmor</researchPrerequisite> -->
    <!-- </recipeMaker> -->
    <equippedStatOffsets>
      <InjuryHealingFactor>2</InjuryHealingFactor>
      <PsychicSensitivity>2</PsychicSensitivity>
      <PsychicSensitivityOffset MayRequire="ludeon.rimworld.royalty">0.20</PsychicSensitivityOffset>
      <PsychicEntropyRecoveryRate MayRequire="ludeon.rimworld.royalty">0.090</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>240000</WorkToMake>
      <MaxHitPoints>1200</MaxHitPoints>
      <MarketValue>7800</MarketValue>
      <Mass>11</Mass>
      <Flammability>0.0</Flammability>
      <ArmorRating_Sharp>1.65</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.3</ArmorRating_Blunt>
      <ArmorRating_Heat>1.5</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <Insulation_Heat>14</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Plasteel>350</Plasteel>
      <Gold>72</Gold>
      <Uranium>50</Uranium>
      <ComponentSpacer>18</ComponentSpacer>
      <ComponentIndustrial>20</ComponentIndustrial>
    </costList>
    <apparel>
      <wornGraphicPath>Emperor/GW_HRM_Emperor_ArmorW</wornGraphicPath>
      <tags>
        <li>GW_ChapterMaster</li>
      </tags>
      <drawData>
        <scale>1.2</scale>
      </drawData>
    </apparel>
    <modExtensions>
      <li Class="RimDark.MastersOfMankind.DefModExtension_ApparelRestriction">
        <isRestrictStat>true</isRestrictStat>
        <statDef>PsychicSensitivity</statDef>
        <reqMode>GreaterEqual</reqMode>
        <value>1.4</value>
      </li>
    </modExtensions>
    <comps>
      <li Class="RimDark.MastersOfMankind.CompProperties_ApparelSet">
        <apparelSetEffect>
          <allApparels>
            <li>GW_Rulers_EmperorArmorW</li>
            <li>GW_Rulers_EmperorShoulderW</li>
            <li>GW_Rulers_EmperorHelmetW</li>
          </allApparels>
          <hediff>GW_Ruler_EmperorAura</hediff>
        </apparelSetEffect>
      </li>
    </comps>
  </ThingDef>
