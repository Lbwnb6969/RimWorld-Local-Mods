  <HediffDef>
    <defName>GW_Ruler_MalcadorBonus</defName>
    <label>Wisdom of Malcador</label>
    <description>Armed with the wits of Malcador the Sigillite, this pawn can negotiate a more desirable deal in trade.</description>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <stages>
      <li>
        <statFactors>
          <NegotiationAbility>1.5</NegotiationAbility>
          <TradePriceImprovement>1.5</TradePriceImprovement>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDef>GW_Ruler_MalcadorAbility</abilityDef>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>GW_Ruler_MalcadorDebuff</defName>
    <label>Imposed Will</label>
    <description>This pawn's mind is being crushed by the will of the Sigillite.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
