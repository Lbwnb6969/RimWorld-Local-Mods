      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="Auto_GW_Rulers_ValdorShoulderW" or defName="Auto_GW_Rulers_ValdorShoulder"]/ingredients/li[filter/thingDefs/li="Plasteel"]/count</xpath>
        <value><count>25</count></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="Auto_GW_Rulers_ValdorShoulderW" or defName="Auto_GW_Rulers_ValdorShoulder"]/ingredients/li[filter/thingDefs/li="Gold"]/count</xpath>
