        <xpath>Defs/ThingDef[defName="GW_Rulers_ValdorShoulderW" or defName="GW_Rulers_ValdorShoulder"]/costList/DankPyon_Ruby</xpath>
        <value><DankPyon_Ruby>6</DankPyon_Ruby></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GW_Rulers_ValdorShoulderW" or defName="GW_Rulers_ValdorShoulder"]/costList/DankPyon_Sapphire</xpath>
        <value><DankPyon_Sapphire>6</DankPyon_Sapphire></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GW_Rulers_ValdorShoulderW" or defName="GW_Rulers_ValdorShoulder"]/costList/DankPyon_Emerald</xpath>
