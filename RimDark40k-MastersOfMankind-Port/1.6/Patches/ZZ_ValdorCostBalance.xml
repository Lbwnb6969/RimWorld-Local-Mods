      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GW_Rulers_ValdorHelmetW" or defName="GW_Rulers_ValdorHelmet"]/costList/Gold</xpath>
        <value><Gold>20</Gold></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="Auto_GW_Rulers_ValdorHelmetW" or defName="Auto_GW_Rulers_ValdorHelmet"]/ingredients/li[filter/thingDefs/li="Plasteel"]/count</xpath>
