        <subSounds><li><grains><li Class="AudioGrain_Folder"><clipFolderPath>Pawn/Animal/Wolverine/Pain</clipFolderPath></li></grains><volumeRange>20</volumeRange><pitchRange>0.8~1.0</pitchRange><distRange>0~70</distRange></li></subSounds>
      </value>
    </match>
